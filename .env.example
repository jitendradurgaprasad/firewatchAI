# Local configuration template. Email delivery is opt-in; run notices report session status, not fire alerts.
FIREWATCH_DATA_DIR=
FIREWATCH_DB_PATH=
FIREWATCH_AUTOLOAD_SAMPLE=1
FIREWATCH_REVIEWER_ID=
FIREWATCH_DELIVERY_MODE=simulation
FIREWATCH_RUN_NOTICE_ENABLED=0
FIREWATCH_TEST_RECIPIENTS=
FIREWATCH_ERS_EMAIL=
FIREWATCH_SMTP_HOST=
FIREWATCH_SMTP_PORT=587
FIREWATCH_SMTP_USERNAME=
FIREWATCH_SMTP_PASSWORD=
FIREWATCH_SMTP_FROM=
# Optional free NASA FIRMS API key; never commit a real key.
FIRMS_MAP_KEY=
